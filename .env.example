# ---------------------------------------------------------------------------
# docker compose (copy to .env to override the defaults)
# ---------------------------------------------------------------------------
POSTGRES_USER=fleetmind
POSTGRES_PASSWORD=fleetmind
POSTGRES_DB=fleetmind
POSTGRES_PORT=5432
FRONTEND_PORT=8080
FLEETMIND_EXPERIMENT_WORKERS=4

# ---------------------------------------------------------------------------
# Backend settings (also read from backend/.env when running locally)
# ---------------------------------------------------------------------------
# Primary database (PostgreSQL)
FLEETMIND_DATABASE_URL=postgresql+psycopg://fleetmind:fleetmind@localhost:5432/fleetmind
# Used only if PostgreSQL is unreachable; set to empty to run without persistence instead.
FLEETMIND_DATABASE_FALLBACK_URL=sqlite:///./fleetmind.db
# Persist live runs (decision timeline, metric samples, final robot/order records)
FLEETMIND_PERSIST_LIVE_RUNS=true

# Simulation pacing: 0.5 s ticks × 16 ticks/s = 8 simulated seconds per second at 1×
FLEETMIND_TICK_SECONDS=0.5
FLEETMIND_BASE_TICKS_PER_SECOND=16
FLEETMIND_BROADCAST_HZ=15

# Scenario loaded on startup (demo | baseline | congestion | road_closure | battery_critical | surge)
FLEETMIND_DEFAULT_SCENARIO=demo
FLEETMIND_DEFAULT_SEED=42173
